# ============================================================
# Environment Variables — Mohammad Ejaz Mehendi Portfolio
# ============================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env   (never commit .env to Git)
# 2. Fill in your actual credentials below
# 3. For Vercel deployment: add these in
#    Project Settings → Environment Variables → Add Variable
#    Then redeploy for changes to take effect.
#
# HOW TO GET THESE VALUES:
#   - Supabase: https://supabase.com → Settings → API
#   - Resend:   https://resend.com   → API Keys → Create API Key
#
# SECURITY WARNING:
#   - NEVER use VITE_ prefix for these variables.
#   - VITE_ variables are exposed in the browser bundle.
#   - These variables are only used server-side in api/contact.js.
# ============================================================

# --- Supabase Database ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Resend Email Notifications ---
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_EMAIL=ejazmehendi123@gmail.com
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
