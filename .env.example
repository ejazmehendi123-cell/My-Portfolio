# ============================================================
# Environment Variables — Mohammad Ejaz Mehendi Portfolio
# ============================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env   (never commit .env to Git)
# 2. Fill in your actual Supabase credentials below
# 3. For Vercel deployment: add these in
#    Project Settings → Environment Variables → Add Variable
#    Then redeploy for changes to take effect.
#
# HOW TO GET THESE VALUES:
#   - Go to https://supabase.com → Your Project → Settings → API
#   - Project URL       →  SUPABASE_URL
#   - service_role key  →  SUPABASE_SERVICE_ROLE_KEY  (keep this SECRET)
#
# SECURITY WARNING:
#   - NEVER use VITE_ prefix for these variables.
#   - VITE_ variables are exposed in the browser bundle.
#   - These variables are only used server-side in api/contact.js.
# ============================================================

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
